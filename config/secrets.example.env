# Copy to config/secrets.env or export these variables in your shell.
# Do not commit config/secrets.env.

# Optional Lark/Feishu webhook override.
DAILY_INTEL_LARK_WEBHOOK=

# Optional multiple bot targets. Keep real URLs in config/secrets.env or shell env only.
# With push.yaml target_policy=primary_only, numbered targets remain stored but are not sent automatically.
DAILY_INTEL_LARK_WEBHOOK_1=
DAILY_INTEL_LARK_WEBHOOK_2=
# Optional per-bot switches. Use these to keep a webhook configured but skip daily pushes.
DAILY_INTEL_LARK_WEBHOOK_1_ENABLED=true
DAILY_INTEL_LARK_WEBHOOK_2_ENABLED=true
# Or comma/space separated:
DAILY_INTEL_LARK_WEBHOOKS=
# Optional comma/space separated exclusion list for ad-hoc local setups.
DAILY_INTEL_LARK_DISABLED_WEBHOOKS=

# Optional agent command. Equivalent to runtime.yaml agent_command.
# Examples:
# DAILY_INTEL_AGENT_CMD='claude -p "$(cat {prompt})"'
# DAILY_INTEL_AGENT_CMD='codex exec "$(cat {prompt})"'
DAILY_INTEL_AGENT_CMD=

# Optional providers.
# Gate CLI search-x is an optional X/Twitter candidate-discovery provider when configured locally.
X_BEARER_TOKEN=
NEWS_API_KEY=
